{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Streaming Fault Detection - Quick Start\n",
    "\n",
    "This notebook demonstrates the basic usage of EnergyFaultDetector's streaming capabilities.\n",
    "\n",
    "## Overview\n",
    "\n",
    "The streaming functionality allows you to:\n",
    "- Process data from CSV files in batches (simulating streaming)\n",
    "- Generate synthetic data for testing\n",
    "- Perform real-time fault detection\n",
    "- Track results and performance metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import tempfile\n",
    "import os\n",
    "\n",
    "# Import EnergyFaultDetector streaming components\n",
    "from energy_fault_detector import StreamingFaultDetector, Config\n",
    "from energy_fault_detector.data_sources import CSVStreamDataSource, SimulatedFaultDataSource, StreamConfig\n",
    "from energy_fault_detector.config import generate_quickstart_config\n",
    "\n",
    "print(\"✓ All imports successful\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Create Synthetic Data with Faults\n",
    "\n",
    "First, let's create some synthetic data with known faults to test our streaming detector."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set random seed for reproducibility\n",
    "np.random.seed(42)\n",
    "\n",
    "# Create synthetic time series data\n",
    "n_samples = 2000\n",
    "n_features = 3\n",
    "\n",
    "# Generate base data (normal operation)\n",
    "time = np.linspace(0, 10 * np.pi, n_samples)\n",
    "data = {\n",
    "    'sensor_1': np.sin(time) + np.random.randn(n_samples) * 0.1,\n",
    "    'sensor_2': np.cos(time * 0.5) + np.random.randn(n_samples) * 0.1,\n",
    "    'sensor_3': np.sin(time * 2) + np.random.randn(n_samples) * 0.1,\n",
    "}\n",
    "\n",
    "# Add some anomalies (faults)\n",
    "data['sensor_1'][500:550] = 10.0  # Large spike\n",
    "data['sensor_2'][1000:1020] = -8.0  # Negative spike\n",
    "data['sensor_3'][1500:1510] = 5.0  # Smaller spike\n",
    "\n",
    "# Create DataFrame\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "# Plot the data to visualize the faults\n",
    "plt.figure(figsize=(15, 8))\n",
    "for col in df.columns:\n",
    "    plt.plot(df[col], label=col, alpha=0.7)\n",
    "plt.axvline(500, color='r', linestyle='--', alpha=0.5, label='Fault 1')\n",
    "plt.axvline(1000, color='g', linestyle='--', alpha=0.5, label='Fault 2')\n",
    "plt.axvline(1500, color='b', linestyle='--', alpha=0.5, label='Fault 3')\n",
    "plt.title('Synthetic Sensor Data with Faults')\n",
    "plt.xlabel('Sample Index')\n",
    "plt.ylabel('Value')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Save to CSV and Create Stream Source\n",
    "\n",
    "Save the synthetic data to a CSV file and create a streaming data source."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save to temporary CSV file\n",
    "with tempfile.NamedTemporaryFile(mode='w', suffix='.csv', delete=False) as f:\n",
    "    df.to_csv(f.name, index=False)\n",
    "    csv_path = f.name\n",
    "\n",
    "print(f"Data saved to: {csv_path}")\n",
    "\n",
    "# Create CSV stream data source\n",
    "csv_source = CSVStreamDataSource(\n",
    "    file_path=csv_path,\n",
    "    config=StreamConfig(batch_size=100, delay_seconds=0)  # No delay for faster processing\n",
    ")\n",
    "\n",
    "print(f"CSV source created with batch_size={csv_source.config.batch_size}")\n",
    "print(f"Total rows in CSV: {csv_source.total_rows}")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Initialize Streaming Fault Detector\n",
    "\n",
    "Create and initialize the streaming fault detector with training data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate quickstart configuration\n",
    "config = generate_quickstart_config()\n",
    "\n",
    "# Create streaming detector\n",
    "detector = StreamingFaultDetector(\n",
    "    config=config,\n",
    "    buffer_size=500,  # Store last 500 samples\n",
    "    online_learning=False  # Disable for this example\n",
    ")\n",
    "\n",
    "# Initialize with normal data (first 500 samples, before faults)\n",
    "normal_data = df.iloc[:500]\n",
    "detector.initialize(fit_data=normal_data)\n",
    "\n",
    "print(\"✓ StreamingFaultDetector initialized and trained on normal data\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Process the Stream\n",
    "\n",
    "Process the CSV stream and detect anomalies."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Process the stream\n",
    "print(\"Processing stream...\")\n",
    "result = detector.process_stream(csv_source)\n",
    "\n",
    "# Display results\n",
    "print(f\"\\n📊 Results Summary:\")\n",
    "print(f\"  Total samples processed: {result.total_samples}\")\n",
    "print(f\"  Total anomalies detected: {result.total_anomalies}\")\n",
    "print(f\"  Number of batches: {len(result.batch_results)}\")\n",
    "print(f\"  Processing time: {result.total_processing_time:.3f} seconds\")\n",
    "print(f\"  Throughput: {result.throughput:.2f} samples/second\")\n",
    "print(f\"  Anomaly rate: {result.total_anomalies / result.total_samples * 100:.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Visualize Results\n",
    "\n",
    "Plot the anomaly scores and detected anomalies."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get results as DataFrame\n",
    "results_df = result.to_dataframe()\n",
    "\n",
    "# Add the original data to the results\n",
    "results_df['sensor_1'] = df['sensor_1'].values[:len(results_df)]\n",
    "\n",
    "# Plot results\n",
    "plt.figure(figsize=(15, 8))\n",
    "\n",
    "# Plot sensor data\n",
    "plt.plot(results_df.index, results_df['sensor_1'], label='Sensor 1', alpha=0.7)\n",
    "\n",
    "# Plot anomaly scores\n",
    "plt.plot(results_df.index, results_df['anomaly_score'], label='Anomaly Score', color='orange', alpha=0.7)\n",
    "\n",
    "# Highlight anomalies\n",
    "anomaly_indices = results_df[results_df['is_anomaly']].index\n",
    "plt.scatter(anomaly_indices, results_df.loc[anomaly_indices, 'sensor_1'], \n",
    "            color='red', label='Detected Anomalies', s=50, zorder=5)\n",
    "\n",
    "# Add threshold line (approximate)\n",
    "threshold = results_df['anomaly_score'].quantile(0.95)  # Approximate threshold\n",
    "plt.axhline(threshold, color='gray', linestyle='--', label='Threshold (approx)')\n",
    "\n",
    "plt.title('Streaming Fault Detection Results')\n",
    "plt.xlabel('Sample Index')\n",
    "plt.ylabel('Value / Score')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Analyze Batch Results\n",
    "\n",
    "Examine the results for each batch."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get anomalies DataFrame\n",
    "anomalies_df = result.get_anomalies()\n",
    "\n",
    "print(f\"Detected {len(anomalies_df)} anomalies\")\n",
    "print(f\"\\nFirst 10 anomalies:\")\n",
    "print(anomalies_df.head(10))\n",
    "\n",
    "# Analyze batch results\n",
    "print(f\"\\nBatch-by-batch analysis:\")\n",
    "for i, batch_result in enumerate(result.batch_results[:10]):  # First 10 batches\n",
    "    print(f\"  Batch {batch_result.batch_index}: {batch_result.n_anomalies} anomalies, "\n",
    "          f\"processing time: {batch_result.processing_time*1000:.2f}ms\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Using Synthetic Data Source\n",
    "\n",
    "Now let's try with the built-in synthetic data source."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create synthetic data source\n",
    "synthetic_source = SimulatedFaultDataSource(\n",
    "    n_samples=1000,\n",
    "    n_features=3,\n",
    "    config=StreamConfig(batch_size=50, delay_seconds=0),\n",
    "    fault_rate=0.3,  # Higher fault rate for demonstration\n",
    "    fault_magnitude=5.0,\n",
    "    feature_names=['temp', 'pressure', 'vibration']\n",
    ")\n",
    "\n",
    "# Create a new detector for synthetic data\n",
    "detector2 = StreamingFaultDetector(config=config)\n",
    "\n",
    "# Initialize with normal synthetic data\n",
    "normal_synthetic = pd.DataFrame(np.random.randn(200, 3), columns=['temp', 'pressure', 'vibration'])\n",
    "detector2.initialize(fit_data=normal_synthetic)\n",
    "\n",
    "# Process synthetic stream\n",
    "print(\"Processing synthetic stream...\")\n",
    "synthetic_result = detector2.process_stream(synthetic_source)\n",
    "\n",
    "print(f\"\\nSynthetic Stream Results:\")\n",
    "print(f\"  Total samples: {synthetic_result.total_samples}\")\n",
    "print(f\"  Anomalies detected: {synthetic_result.total_anomalies}\")\n",
    "print(f\"  Anomaly rate: {synthetic_result.total_anomalies / synthetic_result.total_samples * 100:.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Cleanup\n",
    "\n",
    "Clean up temporary files and resources."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clean up temporary CSV file\n",
    "os.unlink(csv_path)\n",
    "print(\"✓ Temporary file cleaned up\")\n",
    "\n",
    "# Close detectors\n",
    "detector.close()\n",
    "detector2.close()\n",
    "print(\"✓ Detectors closed\")\n",
    "\n",
    "print(\"\\n🎉 Streaming Fault Detection Quick Start Complete!\")"
   ]
  }
 ],
