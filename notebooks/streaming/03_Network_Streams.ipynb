    "## 5. Streaming Fault Detection with Network Sources\n",
    "\n",
    "Combine network sources with StreamingFaultDetector."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a UDP simulator for fault detection test\n",
    "class FaultUDPSimulator:\n",
    "    def __init__(self, port=5557, n_messages=500):\n",
    "        self.port = port\n",
    "        self.n_messages = n_messages\n",
    "        self.running = False\n",
    "        self.thread = None\n",
    "    \n",
    "    def start(self):\n",
    "        self.running = True\n",
    "        self.thread = threading.Thread(target=self._send_data, daemon=True)\n",
    "        self.thread.start()\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    def _send_data(self):\n",
    "        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n",
    "        for i in range(self.n_messages):\n",
    "            if not self.running:\n",
    "                break\n",
    "            \n",
    "            # Normal data\n",
    "            if i < 200 or i > 300:\n",
    "                values = [float(i), np.random.randn() * 0.1, np.random.randn() * 0.1]\n",
    "            # Fault data (large values)\n",
    "            else:\n",
    "                values = [float(i), 10.0 + np.random.randn() * 0.5, 10.0 + np.random.randn() * 0.5]\n",
    "            \n",
    "            packet = struct.pack('3d', *values)\n",
    "            sock.sendto(packet, ('localhost', self.port))\n",
    "            time.sleep(0.01)\n",
    "        sock.close()\n",
    "    \n",
    "    def stop(self):\n",
    "        self.running = False\n",
    "        if self.thread:\n",
    "            self.thread.join(timeout=1.0)\n",
    "\n",
    "# Start fault UDP simulator\n",
    "fault_udp_sim = FaultUDPSimulator(port=5557, n_messages=500)\n",
    "fault_udp_sim.start()\n",
    "print(\"✓ Fault UDP simulator started on port 5557\")\n",
    "\n",
    "# Create UDP source\n",
    "fault_udp_source = UDPStreamDataSource(\n",
    "    host='localhost',\n",
    "    port=5557,\n",
    "    config=StreamConfig(batch_size=50, timeout=1.0),\n",
    "    packet_parser=udp_sensor_parser  # Use the same parser as before\n",
    ")\n",
    "\n",
    "# Create streaming detector\n",
    "config = generate_quickstart_config()\n",
    "detector = StreamingFaultDetector(config=config)\n",
    "\n",
    "# Initialize with normal data (first 100 samples from simulator)\n",
    "fault_udp_source.open()\n",
    "normal_batches = []\n",
    "for i, batch in enumerate(fault_udp_source):\n",
    "    normal_batches.append(batch)\n",
    "    if i >= 1:  # Get 2 batches for training\n",
    "        break\n",
    "\n",
    "# Combine normal data\n",
    "normal_data = pd.concat([b.data for b in normal_batches], ignore_index=True)\n",
    "print(f\"✓ Training with {len(normal_data)} normal samples\")\n",
    "\n",
    "# Initialize detector\n",
    "detector.initialize(fit_data=normal_data)\n",
    "print(\"✓ Detector initialized\")\n",
    "\n",
    "# Reset the source for fresh data\n",
    "fault_udp_source.close()\n",
    "fault_udp_source.reset()\n",
    "fault_udp_source.open()\n",
    "\n",
    "# Process stream with fault detection\n",
    "print(\"Processing stream with fault detection...\")\n",
    "result = detector.process_stream(fault_udp_source, max_batches=8)\n",
    "\n",
    "print(f\"\\nFault Detection Results:\")\n",
    "print(f\"  Total samples: {result.total_samples}\")\n",
    "print(f\"  Anomalies detected: {result.total_anomalies}\")\n",
    "print(f\"  Anomaly rate: {result.total_anomalies / result.total_samples * 100:.2f}%\")\n",
    "\n",
    "# Clean up\n",
    "fault_udp_source.close()\n",
    "fault_udp_sim.stop()\n",
    "detector.close()\n",
    "print(\"✓ Fault detection test completed\")"
   ]
