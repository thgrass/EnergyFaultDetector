    "## 2. Phasor UDP Data Source\n",
    "\n",
    "Demonstrate phasor data processing with a simulated PMU."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a PMU simulator\n",
    "class PMUSimulator:\n",
    "    def __init__(self, port=4712, n_messages=100):\n",
    "        self.port = port\n",
    "        self.n_messages = n_messages\n",
    "        self.running = False\n",
    "        self.thread = None\n",
    "    \n",
    "    def start(self):\n",
    "        self.running = True\n",
    "        self.thread = threading.Thread(target=self._send_data, daemon=True)\n",
    "        self.thread.start()\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    def _send_data(self):\n",
    "        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n",
    "        for i in range(self.n_messages):\n",
    "            if not self.running:\n",
    "                break\n",
    "            header = b'\\x00' * 16\n",
    "            angle = 2 * np.pi * i / 100\n",
    "            phasor_data = struct.pack('6f',\n",
    "                np.cos(angle).astype(np.float32),\n",
    "                np.sin(angle).astype(np.float32),\n",
    "                np.cos(angle + 2*np.pi/3).astype(np.float32),\n",
    "                np.sin(angle + 2*np.pi/3).astype(np.float32),\n",
    "                np.cos(angle + 4*np.pi/3).astype(np.float32),\n",
    "                np.sin(angle + 4*np.pi/3).astype(np.float32),\n",
    "            )\n",
    "            packet = header + phasor_data\n",
    "            sock.sendto(packet, ('localhost', self.port))\n",
    "            time.sleep(0.01)\n",
    "        sock.close()\n",
    "    \n",
    "    def stop(self):\n",
    "        self.running = False\n",
    "        if self.thread:\n",
    "            self.thread.join(timeout=1.0)\n",
    "\n",
    "# Start PMU simulator\n",
    "pmu_simulator = PMUSimulator(port=4712, n_messages=200)\n",
    "pmu_simulator.start()\n",
    "print(\"✓ PMU simulator started on port 4712\")\n",
    "\n",
    "# Create Phasor UDP data source\n",
    "pmu_source = PhasorUDPDataSource(\n",
    "    host='localhost',\n",
    "    port=4712,\n",
    "    config=StreamConfig(batch_size=20, timeout=1.0),\n",
    "    n_phasors=3\n",
    ")\n",
    "\n",
    "print(f\"✓ PhasorUDPDataSource created for {pmu_source.n_phasors} phasors\")\n",
    "\n",
    "# Open and receive data\n",
    "pmu_source.open()\n",
    "\n",
    "# Collect some batches\n",
    "pmu_batches = []\n",
    "for i, batch in enumerate(pmu_source):\n",
    "    pmu_batches.append(batch)\n",
    "    if i >= 4:\n",
    "        break\n",
    "\n",
    "print(f\"✓ Received {len(pmu_batches)} batches of phasor data\")\n",
    "print(f\"  Columns: {list(pmu_batches[0].data.columns)}\")\n",
    "print(pmu_batches[0].data.head())\")\n",
    "\n",
    "# Clean up\n",
    "pmu_source.close()\n",
    "pmu_simulator.stop()\n",
    "print(\"✓ PMU test completed\")"
   ]
  },
