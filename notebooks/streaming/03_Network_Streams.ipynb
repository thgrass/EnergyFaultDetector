    "## 3. TCP Stream Data Source\n",
    "\n",
    "Demonstrate TCP streaming with a simulated TCP server."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a TCP server for testing\n",
    "class TCPServerSimulator:\n",
    "    def __init__(self, port=5556, n_messages=100):\n",
    "        self.port = port\n",
    "        self.n_messages = n_messages\n",
    "        self.server_socket = None\n",
    "        self.client_socket = None\n",
    "        self.running = False\n",
    "        self.thread = None\n",
    "    \n",
    "    def start(self):\n",
    "        self.running = True\n",
    "        self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n",
    "        self.server_socket.bind(('localhost', self.port))\n",
    "        self.server_socket.listen(1)\n",
    "        self.server_socket.settimeout(1.0)\n",
    "        self.thread = threading.Thread(target=self._accept_connections, daemon=True)\n",
    "        self.thread.start()\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    def _accept_connections(self):\n",
    "        while self.running:\n",
    "            try:\n",
    "                self.client_socket, addr = self.server_socket.accept()\n",
    "                self.client_socket.settimeout(1.0)\n",
    "                self._send_data()\n",
    "            except socket.timeout:\n",
    "                continue\n",
    "            except Exception:\n",
    "                break\n",
    "    \n",
    "    def _send_data(self):\n",
    "        for i in range(self.n_messages):\n",
    "            if not self.running:\n",
    "                break\n",
    "            message = f\"{i},{i*2.0},{i*3.0}\\n\"\n",
    "            self.client_socket.sendall(message.encode('utf-8'))\n",
    "            time.sleep(0.01)\n",
    "        self.client_socket.close()\n",
    "        self.client_socket = None\n",
    "    \n",
    "    def stop(self):\n",
    "        self.running = False\n",
    "        for sock in [self.client_socket, self.server_socket]:\n",
    "            if sock:\n",
    "                try:\n",
    "                    sock.close()\n",
    "                except:\n",
    "                    pass\n",
    "        if self.thread:\n",
    "            self.thread.join(timeout=1.0)\n",
    "\n",
    "# Start TCP server simulator\n",
    "tcp_server = TCPServerSimulator(port=5556, n_messages=300)\n",
    "tcp_server.start()\n",
    "print(\"✓ TCP server simulator started on port 5556\")\n",
    "\n",
    "# Create TCP data source (client mode)\n",
    "tcp_source = TCPStreamDataSource(\n",
    "    host='localhost',\n",
    "    port=5556,\n",
    "    mode='client',\n",
    "    config=StreamConfig(batch_size=25, timeout=1.0),\n",
    "    delimiter=b'\\n'\n",
    ")\n",
    "\n",
    "print(f\"✓ TCPStreamDataSource created in client mode\")\n",
    "\n",
    "# Custom parser for CSV-like data\n",
    "def tcp_csv_parser(message_data: bytes, timestamp: float):\n",
    "    try:\n",
    "        text = message_data.decode('utf-8').strip()\n",
    "        values = text.split(',')\n",
    "        data_dict = {\n",
    "            'index': [int(values[0])],\n",
    "            'value_1': [float(values[1])],\n",
    "            'value_2': [float(values[2])],\n",
    "        }\n",
    "        timestamps = np.array([timestamp])\n",
    "        return data_dict, timestamps\n",
    "    except Exception:\n",
    "        return {'raw': [message_data.hex()]}, np.array([timestamp])
",
    "\n",
    "tcp_source.packet_parser = tcp_csv_parser\n",
    "\n",
    "# Open and receive data\n",
    "tcp_source.open()\n",
    "print(f\"✓ TCP source opened and connected\")\n",
    "\n",
    "# Collect some batches\n",
    "tcp_batches = []\n",
    "for i, batch in enumerate(tcp_source):\n",
    "    tcp_batches.append(batch)\n",
    "    if i >= 4:\n",
    "        break\n",
    "\n",
    "print(f\"✓ Received {len(tcp_batches)} batches, {sum(len(b.data) for b in tcp_batches)} samples\")\n",
    "print(f\"  Columns: {list(tcp_batches[0].data.columns)}\")\n",
    "print(tcp_batches[0].data.head())\")\n",
    "\n",
    "# Clean up\n",
    "tcp_source.close()\n",
    "tcp_server.stop()\n",
    "print(\"✓ TCP test completed\")"
   ]
  },
