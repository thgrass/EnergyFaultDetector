    "## 1. UDP Stream Data Source\n",
    "\n",
    "Demonstrate UDP streaming with a simulated UDP server."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a simple UDP server for testing\n",
    "class UDPSimulator:\n",
    "    def __init__(self, port=5555, n_messages=100):\n",
    "        self.port = port\n",
    "        self.n_messages = n_messages\n",
    "        self.running = False\n",
    "        self.thread = None\n",
    "    \n",
    "    def start(self):\n",
    "        self.running = True\n",
    "        self.thread = threading.Thread(target=self._send_data, daemon=True)\n",
    "        self.thread.start()\n",
    "        time.sleep(0.1)\n",
    "    \n",
    "    def _send_data(self):\n",
    "        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n",
    "        for i in range(self.n_messages):\n",
    "            if not self.running:\n",
    "                break\n",
    "            sensor_data = [float(i), float(i * 2), float(i * 3)]\n",
    "            packet = struct.pack('3d', *sensor_data)\n",
    "            sock.sendto(packet, ('localhost', self.port))\n",
    "            time.sleep(0.01)\n",
    "        sock.close()\n",
    "    \n",
    "    def stop(self):\n",
    "        self.running = False\n",
    "        if self.thread:\n",
    "            self.thread.join(timeout=1.0)\n",
    "\n",
    "# Start UDP simulator\n",
    "udp_simulator = UDPSimulator(port=5555, n_messages=500)\n",
    "udp_simulator.start()\n",
    "print(\"✓ UDP simulator started on port 5555\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Custom parser for our UDP data format\n",
    "def udp_sensor_parser(packet_data: bytes, timestamp: float):\n",
    "    try:\n",
    "        values = struct.unpack('3d', packet_data)\n",
    "        data_dict = {\n",
    "            'sensor_1': [values[0]],\n",
    "            'sensor_2': [values[1]],\n",
    "            'sensor_3': [values[2]],\n",
    "        }\n",
    "        timestamps = np.array([timestamp])\n",
    "        return data_dict, timestamps\n",
    "    except struct.error:\n",
    "        return {'raw_data': [packet_data.hex()]}, np.array([timestamp])
",
    "\n",
    "# Create UDP data source with custom parser\n",
    "udp_source = UDPStreamDataSource(\n",
    "    host='localhost',\n",
    "    port=5555,\n",
    "    config=StreamConfig(batch_size=50, timeout=1.0),\n",
    "    packet_parser=udp_sensor_parser\n",
    ")\n",
    "\n",
    "print(f\"✓ UDPStreamDataSource created on port {udp_source.port}\")\n",
    "\n",
    "# Open the source and receive some data\n",
    "udp_source.open()\n",
    "print(f\"✓ UDP source opened\")\n",
    "\n",
    "# Collect a few batches\n",
    "batches = []\n",
    "for i, batch in enumerate(udp_source):\n",
    "    batches.append(batch)\n",
    "    if i >= 4:\n",
    "        break\n",
    "\n",
    "print(f\"✓ Received {len(batches)} batches, {sum(len(b.data) for b in batches)} samples\")\n",
    "\n",
    "# Display first batch\n",
    "first_batch = batches[0]\n",
    "print(f\"First batch columns: {list(first_batch.data.columns)}\")\n",
    "print(first_batch.data.head())\")\n",
    "\n",
    "# Get statistics\n",
    "stats = udp_source.statistics\n",
    "print(f\"\\nUDP Statistics: {stats['packets_received']} packets, {stats['packets_per_second']:.2f} packets/sec\")\n",
    "\n",
    "# Clean up\n",
    "udp_source.close()\n",
    "udp_simulator.stop()\n",
    "print(\"✓ UDP test completed\")"
   ]
  },
